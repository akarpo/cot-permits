# Cloudflare Pages: only index.html should be served as the site.
# Everything else in the repo is tooling, not web content.
# This is a denylist: any file not matched here is served publicly, including
# the build's own .git checkout.
*.py
*.db
*.xlsx
*.md
.gitignore
.assetsignore
.git
.github/
.wrangler/
__pycache__/
.DS_Store
